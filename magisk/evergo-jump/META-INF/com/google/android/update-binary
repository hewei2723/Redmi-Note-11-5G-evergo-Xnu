#!/sbin/sh
umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() { echo -e "ui_print $1\nui_print" >&2; }

# Magisk's own installer is the canonical one; source it if present.
if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit 0
fi

# Fallback for older Magisk: minimal extraction.
ui_print "- minimal installer (old Magisk)"
mkdir -p "$MODPATH"
unzip -o "$ZIPFILE" -d "$MODPATH" >&2
ui_print "- done"
