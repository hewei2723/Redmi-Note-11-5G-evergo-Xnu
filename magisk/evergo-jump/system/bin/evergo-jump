#!/system/bin/sh
#
# evergo-jump — copy the bundled UEFI FD into reserved DRAM and branch into it.
#
# This is the same operation as scripts/deploy.sh --fd on a build machine, with
# the FD already on the phone instead of pushed over adb. It does not touch any
# partition: the module copies the FD to the physical address the device's own
# device tree reserves, then resets the SoC so the preloader and LK are skipped.
#
# A failed attempt is recovered by holding power for ~15 s. Nothing on storage
# changes, so Android boots normally afterwards.
#
# Exit codes:
#   0  the jump was issued (the phone is now running the firmware)
#   1  setup problem (no root, missing files, bad FD)
#   2  could not read kernel symbol addresses
#   3  insmod failed
#   4  framebuffer handoff geometry gate failed (not safe to jump; retry from
#      the launcher with the screen on)

# This script lives at <module>/system/bin/evergo-jump. Magisk mounts that as
# /system/bin/evergo-jump, so $0 may be either path; resolve through the symlink
# when readlink -f is available, and fall back to the known module directory.
if SELF=$(readlink -f "$0" 2>/dev/null) && [ -n "$SELF" ]; then
  MODDIR=$(dirname "$(dirname "$(dirname "$SELF")")")
else
  MODDIR=/data/adb/modules/evergo-jump
fi

# If that did not land on a real module directory, use the canonical location.
[ -f "$MODDIR/evergo_stage1.ko" ] || MODDIR=/data/adb/modules/evergo-jump

FD="$MODDIR/fd/evergo-hotjump.fd"
KO="$MODDIR/evergo_stage1.ko"
LOG=/data/local/tmp/evergo-jump.log

# The FD must be exactly 2 MiB; anything else is not a raw FD and would fault.
FD_SIZE=2097152

log() { echo "$*" | tee -a "$LOG"; }

: > "$LOG"

# --- preconditions ---------------------------------------------------------

if [ "$(id -u)" != "0" ]; then
  log "ERROR: not root. Run through su."
  exit 1
fi

if [ ! -f "$FD" ]; then
  log "ERROR: bundled FD not found at $FD"
  exit 1
fi

size=$(wc -c < "$FD" | tr -d ' ')
if [ "$size" != "$FD_SIZE" ]; then
  log "ERROR: $FD is $size bytes, expected $FD_SIZE - that is not a raw FD"
  exit 1
fi

if [ ! -f "$KO" ]; then
  log "ERROR: kernel module not found at $KO"
  log "  Build it from stage1/ for your kernel, or install the release build."
  exit 1
fi

# --- kernel symbol addresses ----------------------------------------------
#
# The module needs the addresses of a few kernel functions. They move between
# boots (KASLR), so they are read here at run time rather than baked in.
# kptr_restrict must be 0 for /proc/kallsyms to show real addresses.

echo 0 > /proc/sys/kernel/kptr_restrict 2>/dev/null

sym() { awk -v n="$1" '$3==n{print $1; exit}' /proc/kallsyms; }

S=$(sym smp_send_stop)
F=$(sym filp_open)
R=$(sym kernel_read)
FA=$(sym __flush_dcache_area)

if [ -z "$S" ] || [ -z "$F" ] || [ -z "$R" ]; then
  log "ERROR: cannot read symbol addresses from /proc/kallsyms"
  log "  kernel.kptr_restrict is probably still 1, or the kernel hides symbols."
  log "  smp_send_stop=$S filp_open=$F kernel_read=$R"
  exit 2
fi

log "symbols: smp_send_stop=0x$S filp_open=0x$F kernel_read=0x$R flush=0x$FA"

# --- copy the FD where the module expects it ------------------------------

cp -f "$FD" /data/adb/evergo-hotjump.fd || {
  log "ERROR: cannot copy FD to /data/adb/evergo-hotjump.fd"
  exit 1
}

# --- framebuffer handoff gate ---------------------------------------------
#
# The panel only shows the firmware output cleanly when the handoff geometry
# is exactly 1088x2400 / byte pitch 4352 / 2550 contiguous pages. A wrong
# pitch folds the frame into vertically repeated bands (the AFBC/pitch
# failure). Publish the handoff with the module's mode=11 and REFUSE to jump
# unless the geometry is right; a failed gate costs nothing, a blind jump
# costs a garbled run.

log "publishing framebuffer handoff (mode=11)"
rmmod evergo_stage1 2>/dev/null
if ! insmod "$KO" mode=11; then
  log "ERROR: mode=11 handoff publish failed (insmod error)"
  exit 4
fi
GEO=$(dmesg | grep -a "mode=11" | tail -2)
rmmod evergo_stage1 2>/dev/null
log "$GEO"
echo "$GEO" | grep -q "byte_pitch=4352" || {
  log "ERROR: geometry gate FAILED (byte_pitch is not 4352)."
  log "  The DPU layer state is not safe to jump from."
  log "  Wake the screen, go back to the launcher, and try again."
  exit 4
}
echo "$GEO" | grep -q "pages=2550" || {
  log "ERROR: geometry gate FAILED (pages is not 2550)."
  log "  The scanout buffer is not contiguous enough to hand over."
  log "  Wake the screen, go back to the launcher, and try again."
  exit 4
}
log "geometry OK (1088x2400, pitch 4352, 2550 pages)"

# --- jump ------------------------------------------------------------------
#
# taskset 1 pins to CPU 0, matching the trampoline's assumptions.
# stop=1 halts the other cores before the jump.
# fd_path is the raw FD, not a boot image.

log "jumping into the firmware; the screen is now the only output"

taskset 1 insmod "$KO" mode=5 stop=1 \
  fd_path=/data/adb/evergo-hotjump.fd \
  p_fd_base=0xb0000000 p_jump_pa=0xb0000000 \
  p_smp_send_stop=0x$S p_filp_open=0x$F p_kernel_read=0x$R \
  p_flush_dcache_area=0x$FA p_flush_pa=0x0 p_flush_len=0x0

rc=$?
if [ "$rc" != "0" ]; then
  log "ERROR: insmod failed (exit $rc). See dmesg."
  exit 3
fi

# If we get here the jump did not happen (a successful jump never returns to
# this shell). Say so, because otherwise the caller waits forever.
log "WARNING: insmod returned; the jump did not take effect."
exit 3
