+ * T4 = DxeMain entry (0x90), T5 = dispatcher start (0x98). */
+STATIC
+VOID
+DxeContainerSnapshot (
+  IN UINTN  SlotIdx
+  )
+{
+  volatile UINT32 *Cont = (volatile UINT32 *)0xB5400000ULL;
