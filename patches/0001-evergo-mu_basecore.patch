+  Wdt[2] = 0x1971;
+  asm volatile ("dsb sy" ::: "memory");
+  for (Line = 0; Line < 256; Line += 64) {
+    asm volatile ("dc cvac, %0" :: "r" ((UINTN)DXE_BEACON_BASE + Line));
