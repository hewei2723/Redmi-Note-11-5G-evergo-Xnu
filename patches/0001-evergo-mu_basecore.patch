+//
+// evergo Test-D: DXE-phase beacon, same reserved ramoops page the SEC uses
+// (0x4811FC00). Self-contained (no link dependency on Sec): writes magic+step,
+// kicks the armed 15 s watchdog and cleans the cache so the value survives the
+// watchdog reset. Steps 0x90.. bisect DxeMain's early services; the last step
+// shows where DXE stops making progress.
+//
+#define DXE_BEACON_BASE  0x4811FC00ULL
+#define DXE_BEACON_MIRROR 0xB6BE0000ULL  /* reserved payload window copy */
+#define DXE_TOPRGU_BASE  0x10007000ULL
+
+STATIC
+VOID
+DxeBeacon (
+  IN UINTN  Step
+  )
+{
+  volatile UINT64 *Beacon = (volatile UINT64 *)DXE_BEACON_BASE;
+  volatile UINT32 *Wdt    = (volatile UINT32 *)DXE_TOPRGU_BASE;
+  UINTN            Line;
+
+  TRC (TRC_DXE_STEP + Step, TRC_ENTER, 0, Step, 0, 0, 0);
+  Beacon[0] = 0x53473142ULL;
+  Beacon[1] = (UINT64)Step;
+  {
+    volatile UINT64 *Mirror = (volatile UINT64 *)DXE_BEACON_MIRROR;
+    Mirror[0] = 0x53473142ULL;
+    Mirror[1] = (UINT64)Step;
+  }
+  asm volatile ("dsb sy" ::: "memory");
+  Wdt[2] = 0x1971;                    /* WDT_RST reload */
+  asm volatile ("dsb sy" ::: "memory");
+  for (Line = 0; Line < 512; Line += 64) {
+    asm volatile ("dc cvac, %0" :: "r" ((UINTN)DXE_BEACON_BASE + Line));
+  }
+  asm volatile ("dsb sy" ::: "memory");
