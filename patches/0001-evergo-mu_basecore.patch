+    for (L2 = 0; L2 < 256; L2 += 64) {
+      asm volatile ("dc cvac, %0" :: "r" ((UINTN)DXE_BEACON_BASE + L2));
+    }
+    asm volatile ("dsb sy" ::: "memory");
+  }
